{
  "name": "automation-set-disable-condition",
  "group": "A",
  "description": "An automation update replaces disableConditions with a single max-runs condition.",
  "type": "StateAction",
  "input": {
    "type": "automation/updateRequested",
    "resource": "ahp-automation:/capped",
    "changes": {
      "disableConditions": [{ "kind": "maxRuns", "maxRuns": 3 }]
    }
  },
  "acceptableOutputs": [{
    "type": "automation/updateRequested",
    "resource": "ahp-automation:/capped",
    "changes": {
      "disableConditions": [{ "kind": "maxRuns", "maxRuns": 3 }]
    }
  }]
}
